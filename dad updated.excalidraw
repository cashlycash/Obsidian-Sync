			"fontSize": 36,
			"fontFamily": 1,
			"text": "Key Points\n- Reliable\n- Autonomous\n\nAdmin portal\n\n# Setup\n- Server Code\n\n# Backend\n- Hash based system\n- Reliable Storage\n\n# Main Panel\n- Manage Lifts\n= - Add lift\n= = = Name of building\n= = = Address\n= = = Location (google maps link)\n= = = Contact Person #1\n= = = Contact Person #2 *\n= = = Contact Person #3 *\n= = = Number of floors\n= = = Model number\n= = = Door type \n= = = Floor Designation \n= = = Type of lift (machine room)\n= = = Person Capacity\n= = = Load Capacity\n= = = Motor plate photo\n= = = Drive plate photo",
			"rawText": "",
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Key Points\n- Reliable\n- Autonomous\n\nAdmin portal\n\n# Setup\n- Server Code\n\n# Backend\n- Hash based system\n- Reliable Storage\n\n# Main Panel\n- Manage Lifts\n= - Add lift\n= = = Name of building\n= = = Address\n= = = Location (google maps link)\n= = = Contact Person #1\n= = = Contact Person #2 *\n= = = Contact Person #3 *\n= = = Number of floors\n= = = Model number\n= = = Door type \n= = = Floor Designation \n= = = Type of lift (machine room)\n= = = Person Capacity\n= = = Load Capacity\n= = = Motor plate photo\n= = = Drive plate photo",
			"autoResize": false,
